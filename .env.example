# ==============================================================================
# VICEPULSE — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. MongoDB Database Connection (Required)
# Atlas Cluster or local MongoDB instance (stores discoveries, research jobs, queries, logs)
MONGODB_URI=mongodb+srv://ashutoshkdubey007_db_user:2Q6zFv041FpOg3mq@vicecity.dhrnfsi.mongodb.net/vicepulse?retryWrites=true&w=majority

# 2. Razorpay Payment Gateway (Real QR-based UPI & Card payments)
# In development use test keys starting with rzp_test_
# In production use live keys starting with rzp_live_
RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Registered UPI Virtual Payment Address (VPA) for dynamic UPI QR payloads
RAZORPAY_UPI_VPA=vicepulse@icici

# 3. Resend Transactional & Recon Email Provider
# Obtain API key from https://resend.com/api-keys
RESEND_API_KEY=re_test_placeholder
EMAIL_FROM=VicePulse Recon <recon@vicepulse.net>
EMAIL_REPLY_TO=support@vicepulse.net

# 4. Feature Flags & Operational Toggles
# Set to true to activate live checkout & email dispatches; false runs in safe sandbox mode
PAYMENTS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_ENABLE_PAYMENTS=true

# 5. Pricing Configuration (INR)
NEXT_PUBLIC_PRICE_PRO_MONTHLY_INR=499
NEXT_PUBLIC_PRICE_PRO_YEARLY_INR=4499
NEXT_PUBLIC_PRICE_ELITE_MONTHLY_INR=999
NEXT_PUBLIC_PRICE_ELITE_YEARLY_INR=8999

# 6. Web Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=vicepulse-secret-key-super-secure-leonida-99

# 7. MapLibre GL Tile Provider Configuration
# Default is Esri ArcGIS World Dark Gray Base (no API key required; zero watermarks; no labels)
NEXT_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_MAP_ATTRIBUTION=© Esri, HERE, Garmin, © OpenStreetMap contributors
NEXT_PUBLIC_MAP_MIN_ZOOM=7
NEXT_PUBLIC_MAP_MAX_ZOOM=18

# 8. Autonomous Intelligence Engine (AI & LLM Provider)
GEMINI_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
SOCIAL_SEARCH_API_KEY=
